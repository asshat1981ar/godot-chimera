[node name="BackButton" type="Button" parent="VBox"]
layout_mode = 2
text = "Back"

[connection signal="toggled" from="VBox/MusicCheck" to="." method="_on_music_toggled"]
[connection signal="toggled" from="VBox/SfxCheck" to="." method="_on_sfx_toggled"]
[connection signal="toggled" from="VBox/MotionCheck" to="." method="_on_motion_toggled"]
[connection signal="toggled" from="VBox/AiCheck" to="." method="_on_ai_toggled"]
[connection signal="value_changed" from="VBox/SpeedSlider" to="." method="_on_speed_changed"]
[connection signal="pressed" from="VBox/BackButton" to="." method="_on_back_pressed"]
