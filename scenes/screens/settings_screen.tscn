[gd_scene load_steps=2 format=3 uid="uid://settingsscreen001"]

[ext_resource type="Script" path="res://scripts/ui/settings_screen.gd" id="1_set"]

[node name="SettingsScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_set")

[node name="ColorRect" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
grow_horizontal = 2
grow_vertical = 2
color = Color(0.06, 0.05, 0.04, 1)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -260.0
offset_top = -240.0
offset_right = 260.0
offset_bottom = 240.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "Settings"
horizontal_alignment = 1

[node name="MusicCheck" type="CheckBox" parent="VBox"]
layout_mode = 2
text = "Music enabled"

[node name="SfxCheck" type="CheckBox" parent="VBox"]
layout_mode = 2
text = "SFX enabled"

[node name="MotionCheck" type="CheckBox" parent="VBox"]
layout_mode = 2
text = "Reduced motion"

[node name="AiCheck" type="CheckBox" parent="VBox"]
layout_mode = 2
text = "Cloud AI dialogue (experimental)"

[node name="SpeedLabel" type="Label" parent="VBox"]
layout_mode = 2
text = "Text speed: 100%"

[node name="SpeedSlider" type="HSlider" parent="VBox"]
layout_mode = 2
min_value = 10.0
max_value = 50.0
