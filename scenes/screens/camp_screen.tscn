[gd_scene load_steps=3 format=3 uid="uid://campscreen001"]

[ext_resource type="Script" path="res://scripts/ui/camp_screen.gd" id="1_camp"]
[ext_resource type="Script" path="res://scripts/ui/gothic_button.gd" id="2_gbtn"]

[node name="CampScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_camp")

[node name="ColorRect" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
grow_horizontal = 2
grow_vertical = 2
color = Color(0.06, 0.05, 0.04, 1)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -280.0
offset_right = 360.0
offset_bottom = 280.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "Camp"
horizontal_alignment = 1

[node name="RiskLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Night risk: 0%"
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="PartyList" type="VBoxContainer" parent="VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="LogLabel" type="RichTextLabel" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 140)
text = "The fire burns low..."
bbcode_enabled = true

[node name="SummaryPanel" type="PanelContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="Margin" type="MarginContainer" parent="VBox/SummaryPanel"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="SummaryVBox" type="VBoxContainer" parent="VBox/SummaryPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="ContinueButton" type="Button" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 84)
text = "Continue"
script = ExtResource("2_gbtn")

[node name="MenuButton" type="Button" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 84)
text = "Main Menu"
script = ExtResource("2_gbtn")

[connection signal="pressed" from="VBox/ContinueButton" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="VBox/MenuButton" to="." method="_on_menu_pressed"]
