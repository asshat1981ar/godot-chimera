            "forbiddenCrownChoice": ["wear"]
          }
        },
        {
          "id": "ending_crowned",
          "title": "The Hollow Heir",
          "choice": "dominate",
          "requires": {
            "anyOf": [
              { "crownChoice": "wear" },
              { "items": ["king_shard"], "minDisposition": { "hollow_king": -0.2 } }
            ],
            "forbiddenItems": ["purification_totem"]
          }
        },
        {
          "id": "ending_reforged",
          "title": "Ashes Reforged",
          "choice": "unmake",
          "requires": {
            "completedScenes": ["seren_alliance", "seren_fleet", "kael_loyalty"],
            "minDisposition": { "seren": 0.3, "kael": 0.3 },
            "reveals": ["reforged_prophecy", "crown_nature"],
            "anyOf": [
              { "crownChoice": "offer" },
              { "items": ["signal_flare"] }
            ]
          }
        },
        {
          "id": "ending_merged",
          "title": "The Sea Remembers",
          "choice": "merge",
          "requires": {
            "reveals": ["evolution_theory", "corruption_nature", "tide_prophecy"],
